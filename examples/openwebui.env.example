# Copy to .env.openwebui in the repository root; keep it private (chmod 600).
# Never commit real keys or passwords. See docs/openwebui.md.
OPENAI_API_KEY=
WEBUI_SECRET_KEY=
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=
# Optional: change these if the default loopback ports are occupied.
OPENWEBUI_PORT=3000
OPENWEBUI_PROXY_PORT=8787
